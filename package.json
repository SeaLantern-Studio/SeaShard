{
  "name": "seashard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build && vite build --config apps/desktop/vite.main.config.ts && vite build --config apps/desktop/vite.preload.config.ts && vite build --config apps/plugin-host/vite.config.ts && vite build --config apps/database-worker/vite.config.ts",
    "dev": "node scripts/dev.mjs",
    "check": "vp check && vue-tsc --noEmit",
    "start": "electron apps/desktop/dist/main/index.js",
    "test": "vite build --config apps/database-worker/vite.config.ts && tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "cmzya-modern-ui": "0.6.2",
    "cordis": "4.0.0-rc.8",
    "electron": "43.4.0",
    "fflate": "0.8.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plus": "0.2.9",
    "vue": "3.5.41",
    "vue-router": "5.0.3",
    "vue-tsc": "3.3.10"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.13.1"
}
